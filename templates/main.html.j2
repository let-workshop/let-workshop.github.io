    <!-- ===== TOP NAV ===== -->
    <header class="topbar">
      <div class="wrap">
        <div class="topbar-row">
          <a class="brand" href="#top">{{ wordmark(site.name) }}</a>
          <nav class="tabs" aria-label="Section navigation">
            <ul>
              {% for item in site.nav %}
              <li><a href="{{ item.href }}">{{ t(item.label, item.label_ko) }}</a></li>
              {% endfor %}
            </ul>
          </nav>
          <!-- Two languages, so the control is one button naming the other one
               rather than a segment where half is always inert. -->
          <div class="prefs">
            <!-- The globe says what the control is; the code says where it
                 goes. Each span is shown only in the *other* language, so the
                 button always names the language you would switch to. -->
            <button class="icon-btn" onclick="toggleLang()" aria-label="Change language">
              <svg aria-hidden="true"><use href="#i-globe"></use></svg>
              {% for code in about.codes %}
              <span class="t-{{ about.codes[0] if not loop.first else about.codes[1] }}">{{ code | upper }}</span>
              {% endfor %}
            </button>
            <!-- Three states, so "follow the system" stays reachable — a plain
                 light/dark switch strands anyone whose OS changes at dusk. -->
            <button class="icon-btn" onclick="cycleTheme()" id="theme-btn">
              <svg aria-hidden="true"><use id="theme-icon" href="#i-theme-auto"></use></svg>
              <span class="t-en" id="theme-en">Auto</span>
              <span class="t-ko" id="theme-ko">자동</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Outside the header on purpose. On a phone this is pinned to the bottom
         of the screen, and .topbar carries a backdrop-filter, which makes it a
         containing block for fixed children — nested here it would pin to the
         header instead of to the viewport. -->
    <nav class="tabs-mobile" aria-label="Section navigation">
      <ul>
        {% for item in site.nav %}
        <li><a href="{{ item.href }}">{{ t(item.label, item.label_ko) }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <!-- ===== HERO ===== -->
    <header class="hero{{ ' has-art' if site.hero_background == 'art' }}{{ ' has-flow' if site.hero_background == 'flow' }}" id="top">
      {%- if site.hero_background == 'art' %}
      <!-- The campus, written out in formulas — see tools/formula-art.py. It is
           applied as a mask over a coloured box rather than dropped in as an
           image, so it takes the hero's ink colour and follows the theme; an
           <img> would have to bake one in. -->
      <div class="hero-art" aria-hidden="true"></div>
      {%- elif site.hero_background == 'flow' %}
      <!-- The photograph, seen only through a moving field of formulas. The
           field carries no picture of its own — see tools/formula-art.py
           --flat — so the campus stays put while the writing travels. -->
      <div class="hero-flow" aria-hidden="true"></div>
      {%- else %}
      <!-- Filled in after load, once the formula sprite has been fetched. It is
           decoration: if the fetch fails, or the reader asked for less motion,
           the hero is simply the photograph. -->
      <div class="hero-math" aria-hidden="true"></div>
      {%- endif %}
      <div class="wrap">
        {% if site.eyebrow %}<p class="eyebrow">{{ t(site.eyebrow, site.eyebrow_ko) }}</p>{% endif %}
        <h1>
          <span class="wordmark">{{ wordmark(site.name) }}</span>
          <span class="acronym">{{ site.full_name }}</span>
        </h1>
        {% if site.theme %}<p class="theme">{{ site.year }} Theme · <b>{{ site.theme }}</b></p>{% endif %}

        <!-- The particulars sit on the hero itself, under a hairline, rather
             than in a card that floats over it. -->
        <dl class="hero-meta">
          {% for cell in site.infobar %}
          <div>
            <dt{{ ' class="is-key"' | safe if loop.first }}>
              {% if cell.icon %}<svg aria-hidden="true"><use href="#i-{{ cell.icon }}"></use></svg>{% endif %}{{ t(cell.key, cell.key_ko) }}
            </dt>
            <dd class="{{ 'is-mono' if cell.mono }}">
              {% set shown = t(cell.value, cell.value_ko) %}{% if cell.href %}<a href="{{ cell.href }}">{{ shown }}</a>{% else %}{{ shown }}{% endif %}{% if
              cell.countdown %}<span class="dday" data-from="{{ program.days[0].date }}"></span>{% endif %}{% if
              cell.note %}<small>{{ t(cell.note, cell.note_ko) }}</small>{% endif %}
            </dd>
          </div>
          {% endfor %}
        </dl>

        {% if site.hero_actions %}
        <div class="hero-actions">
          {% for a in site.hero_actions %}
          {% if a.opens_at_ms and not a.is_open %}
          <!-- Both states, and the clock below picks. The live one is the same
               markup the third branch renders and the shut one the same as the
               second; only which is hidden differs. -->
          <span class="btn-note{{ ' is-primary' if a.primary }}"
                data-opens-at="{{ a.opens_at_ms }}" hidden>
            <a class="btn{{ ' btn-primary' if a.primary }}" href="{{ a.href }}"
               {% if a.href.startswith('http') %}target="_blank" rel="noopener"{% endif %}>{{ t(a.label, a.label_ko) }}</a>
            {% if a.note %}<small>{{ t(a.note, a.note_ko) }}</small>{% endif %}
          </span>
          <span class="btn-wait{{ ' is-primary' if a.primary }}" data-shut-until="{{ a.opens_at_ms }}">
            <button class="btn{{ ' btn-primary' if a.primary }}" disabled>{{ t(a.label, a.label_ko) }}</button>
            {% if a.shut_note %}<small>{{ t(a.shut_note, a.shut_note_ko) }}</small>{% endif %}
          </span>
          {% elif a.href %}
          <!-- A live button can carry a note too, but not by borrowing the
               waiting one's box: that one dims its button and gives it a
               not-allowed cursor, which is exactly wrong on a link that works. -->
          <span class="btn-note{{ ' is-primary' if a.primary }}">
            <a class="btn{{ ' btn-primary' if a.primary }}" href="{{ a.href }}"
               {% if a.href.startswith('http') %}target="_blank" rel="noopener"{% endif %}>{{ t(a.label, a.label_ko) }}</a>
            {% if a.note %}<small>{{ t(a.note, a.note_ko) }}</small>{% endif %}
          </span>
          {% else %}
          <span class="btn-wait{{ ' is-primary' if a.primary }}">
            <button class="btn{{ ' btn-primary' if a.primary }}" disabled>{{ t(a.label, a.label_ko) }}</button>
            {% if a.note %}<small>{{ t(a.note, a.note_ko) }}</small>{% endif %}
          </span>
          {% endif %}
          {% endfor %}
          <script>
            // Which of the two the reader gets. Inline and right here, so it
            // has run before the row is painted: a flash of a shut button on a
            // page loaded after the hour would be worse than no button at all.
            (function () {
              var live = document.querySelector("[data-opens-at]");
              if (!live) return;
              var shut = document.querySelector("[data-shut-until]"),
                  at = +live.getAttribute("data-opens-at");
              (function tick() {
                var left = at - Date.now();
                if (left <= 0) { shut.hidden = true; live.hidden = false; return; }
                // Half a minute at a time rather than one long timer: a device
                // that sleeps through the hour wakes with a stale timeout, and
                // this is never more than thirty seconds out.
                setTimeout(tick, Math.min(left, 30000));
              })();
            })();
          </script>
          {% if site.sponsors and site.sponsors.logos %}
          <!-- The two institutions, at the far end of the row the buttons are
               in. Small, and the small files: the section at the foot draws
               them at 44px and these at 22, and this pair is above the fold
               where a mark is decoration and the bytes are not free. -->
          <span class="hero-marks" aria-label="{{ site.sponsors.label }}">
            {% for h in site.sponsors.logos %}
            <a href="{{ h.url }}" target="_blank" rel="noopener" title="{{ h.name }}"
               style="--ratio: {{ h.ratio }}; --baseline: {{ h.baseline }}; --nudge: {{ h.nudge }}">
              <img src="logos/{{ h.small }}" alt="{{ h.name }}" />
            </a>
            {% endfor %}
          </span>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </header>

    <!-- ===== ABOUT ===== -->
    <section id="about" class="band">
      <div class="wrap">
        <h2>{{ t(about.title, about.title_ko) }}</h2>
        {% if about.subtitle %}
        <p class="sub">{{ t(about.subtitle, about.subtitle_ko) }}</p>
        {% endif %}

        {% for lang in about.languages %}
        <div id="about-{{ lang.code }}" class="about{{ '' if loop.first else ' hidden' }}">
          {% if lang.lead %}
          <div class="about-lead">
{% filter indent(12, true) %}{{ lang.lead }}{% endfilter %}
          </div>
          {% endif %}

          {% for block in lang.pillars %}
          <div class="about-block">
            <h3>{{ block.heading }}</h3>
{% filter indent(12, true) %}{{ block.html }}{% endfilter %}
          </div>
          {% endfor %}

          {% for block in lang.wide %}
          <div class="about-block">
            <h3>{{ block.heading }}</h3>
{% filter indent(12, true) %}{{ block.html }}{% endfilter %}
            <div class="topics">
              {% for group in block.groups %}
              <div class="topic-group">
                <h4>{{ group.title }}</h4>
                <p>{{ group.body }}</p>
              </div>
              {% endfor %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
    </section>
    {% if roster %}
    <!-- ===== SPEAKERS (derived from the programme) ===== -->
    <section id="speakers" class="band band-alt">
      <div class="wrap">
        <!-- The order is by surname, not by billing. Said beside the heading so
             it is read before the grid rather than after it.
             Two orders, one grid: the cards are written in the romanised order
             and carry their 가나다 position as a number, which the Korean view
             reads back through `order`. A second copy of the grid would be
             fifteen more cards in the document for a difference that is only
             an arrangement of the ones already there. -->
        <!-- It said "(not final)" while there were still empty slots on the
             programme. There are none; every session is named. -->
        <h2>
          <span class="t-en">Speakers</span><span class="t-ko">연사</span>
          <span class="note">
            <span class="t-en">Alphabetical by surname</span>
            <span class="t-ko">가나다순</span>
          </span>
        </h2>
        <div class="spk-grid">
          {% for s in roster %}
          <!-- The card opens the person: their talk, their abstract, their
               bio. It has been two other things — the session they are in,
               which became a box reading "Invited talk · TBD", and then their
               own homepage, which is a different question than the one a face
               and a name invite. Both are still reachable from inside the
               panel; neither is what the click is for. And nothing here points
               at the timetable while the timetable does not say who is when. -->
          <button class="spk-card" style="--ko-order: {{ s.ko_order }}"
                  onclick="openSpeaker({{ loop.index0 }})">
            {% if s.photo %}
            <img class="spk-face" src="{{ s.photo }}" alt="" loading="lazy" width="256" height="256" />
            {% else %}
            <div class="spk-face spk-blank" aria-hidden="true">{{ s.initials }}</div>
            {% endif %}
            <div class="spk-name">
              {%- if s.role %}<span class="t-en role-above"><span class="role">{{ s.role }}</span></span>{% endif -%}
              {{ t(s.name, s.name_ko) }}
              {%- if s.role %}<span class="t-ko role-beside"> <span class="role">{{ s.role_ko or s.role }}</span></span>{% endif -%}
              <span class="affil">{{ t(s.affil, s.affil_ko) }}</span>
            </div>
            <!-- What they are giving, under who they are. It is the one thing
                 a reader is looking for on a card that is otherwise a face and
                 a name, and it is the thing behind the card as well. Nobody
                 gets a placeholder: a card with no title yet is a card with a
                 name on it, which is finished-looking, and a row of "to be
                 announced" is not. -->
            {% if s.talk %}<div class="spk-talk" lang="en">{{ s.talk_card }}</div>{% endif %}
            <!-- The session's subject, not the talk's — "Bandits" rather than
                 "heavy-tailed". Held back while the schedule is: it is read off
                 the session a speaker is in, and the grid is not saying which
                 session anybody is in yet, so the card would be answering a
                 question the programme beside it refuses. It comes back with
                 the rest when `simple` goes off. -->
            {% if not program.simple %}<div class="spk-topic">{{ s.track }}</div>{% endif %}
          </button>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}
    <!-- ===== PROGRAM ===== -->
    <section id="program" class="band">
      <div class="wrap">
        <h2>{{ t(program.title, program.title_ko) }}{% if program.title_note %}
          <span class="h2-note">({{ t(program.title_note, program.title_note_ko) }})</span>{% endif %}</h2>
        {% set sub = program.subtitle_anon if variant.anonymize else program.subtitle %}
        {% if sub %}
        <p class="sub">{{ sub }}</p>
        {% endif %}

        <div class="legend">
          {% for key, t in types.items() %}
          <span class="item"><span class="swatch sw-{{ key }}"></span> {{ t.label }}</span>
          {% endfor %}
        </div>

        <!-- One row, two segmented controls of the same shape: what to show,
             and which day. The day filter only means anything in the linear
             views, so it hides itself in Grid. -->
        <div class="sched-bar">
          <div class="seg" role="group" aria-label="Programme view">
            <button id="view-btn-grid" class="active" onclick="setView('grid')">Grid</button>
            <button id="view-btn-list" onclick="setView('list')">List</button>
            <button id="view-btn-abstracts" onclick="setView('abstracts')">Abstracts</button>
            <button id="view-btn-now" onclick="setView('now')">Now</button>
          </div>

          <div class="seg" id="day-pills" role="group" aria-label="Day">
            <button class="active" data-day="all" onclick="setDay('all')">All</button>
            {% for day in program.days %}
            <button data-day="{{ loop.index0 }}" data-date="{{ day.date }}" onclick="setDay('{{ loop.index0 }}')">{{ day.short }}</button>
            {% endfor %}
          </div>

          <div class="sched-links">
            <a class="linkish" href="{{ ics_file }}" download>Add to calendar</a>
            <span class="tz-note">{{ program.timezone }} · UTC{{ program.utc_offset }}</span>
          </div>
        </div>

        <!-- List view: the same events as a plain table, and the only view that
             works without horizontal scrolling on a phone. -->
        <div id="view-list" class="view-panel hidden">
          {% for day in program.days %}
          <table class="agenda" data-day="{{ loop.index0 }}">
            <caption>
              {{ day.label }}{% if day.theme %}<span>{{ day.theme }}</span>{% endif %}
            </caption>
            <tbody>
              {% for e in day.events %}
              <tr id="row-{{ e.id }}" class="agenda-row wash-{{ e.type }}" data-begins="{{ e.begins_iso }}" data-ends="{{ e.ends_iso }}" onclick="openEvent('{{ e.id }}')" tabindex="0" onkeydown="if(event.key==='Enter'){openEvent('{{ e.id }}')}">
                <th scope="row" class="when">{{ e.start }} – {{ e.end }}</th>
                <td class="what">
                  {% if e.emoji %}<span class="emoji" aria-hidden="true">{{ e.emoji }}</span>{% endif %}<strong>{{ e.title }}</strong>{% if e.chair %} <span class="chair">(Chair: {{ e.chair }})</span>{% endif %}
                  {% if e.talks %}
                  {% for t in e.talks %}
                  <div class="who">
                    {{ t.line }}
                    {% if t.talk %}<div class="talk-title">{{ t.talk }}</div>{% endif %}
                    {% if t.note %}<span class="staff-note">{{ t.note }}</span>{% endif %}
                  </div>
                  {% endfor %}
                  {% for n in e.notes %}
                  <div class="who"><em>{{ n }}</em></div>
                  {% endfor %}
                  {% else %}
                  {% for s in e.lines %}
                  <div class="who">{{ s }}</div>
                  {% endfor %}
                  {% endif %}
                </td>
                <td class="tag"><span class="badge badge-{{ e.type }}">{{ types[e.type].short }}</span></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% endfor %}
        </div>

        <!-- What is on right now, and what follows. Filled in from EVENTS. -->
        <div id="view-now" class="view-panel hidden"></div>

        <!-- Abstracts view: every talk in order, with its abstract and slides. -->
        <div id="view-abstracts" class="view-panel hidden">
          {% for day in program.days %}
          <div class="abs-day" data-day="{{ loop.index0 }}">
            <h3>{{ day.label }}{% if day.theme %} <span>{{ day.theme }}</span>{% endif %}</h3>
            {% for e in day.events %}
            {% for t in e.talks %}
            <article class="abs">
              <div class="abs-when">{{ e.start }} – {{ e.end }}<span class="badge badge-{{ e.type }}">{{ types[e.type].short }}</span></div>
              <div class="abs-main">
                <div class="abs-who">{{ t.line }}</div>
                {% if t.talk %}<h4>{{ t.talk }}</h4>{% endif %}
                {% if t.abstract %}
                <div class="abs-body">{{ t.abstract }}</div>
                {% else %}
                <p class="abs-none">Abstract to be announced.</p>
                {% endif %}
                {% if t.slides %}
                <a class="pill abs-pdf" href="{{ t.slides }}" target="_blank" rel="noopener">Slides (PDF)</a>
                {% endif %}
              </div>
            </article>
            {% endfor %}
            {% endfor %}
          </div>
          {% endfor %}
        </div>

        <div id="view-grid" class="view-panel schedule-scroll">
          <div
            class="schedule-container"
            style="grid-template-columns: {{ grid.time_column_width }} repeat({{ program.days | length * 2 }}, 1fr); min-width: {{ grid.min_width }}"
          >
            <!-- Column headers -->
            <div class="header" style="grid-column: 1; grid-row: 1 / span {{ grid.header_rows }}">Time</div>
            {% for day in program.days %}
            <div class="header" style="grid-column: {{ loop.index0 * 2 + 2 }} / span 2; grid-row: 1 / span {{ grid.header_rows }}">
              {{ day.label }}{% if day.theme %}<span class="theme">{{ day.theme }}</span>{% endif %}
            </div>
            {% endfor %}

            <!-- Time axis (row {{ grid.header_rows + 1 }} = {{ grid.day_start }}; 1 row = {{ grid.slot_minutes }} min) -->
            {% for tick in axis %}
            <div class="time-axis" style="grid-column: 1; grid-row: {{ tick.row }} / span {{ tick.span }}">{{ tick.label }}</div>
            {% endfor %}
            {% for day in program.days %}

            <!-- ===== {{ day.label }} — {{ day.theme }} ===== -->
            <!-- Two columns per day, so a session that runs alongside another
                 can sit beside it instead of being described in a line of text
                 underneath. Everything else spans both, which is what makes
                 the pair read as one day rather than as two narrow ones. -->
            {% set col = loop.index0 * 2 + 2 %}
            {% for e in day.events %}
            <div id="cell-{{ e.id }}" class="event bg-{{ e.type }}{{ ' ' ~ e.density if e.density }}" data-begins="{{ e.begins_iso }}" data-ends="{{ e.ends_iso }}" style="grid-column: {% if e.track %}{{ col + e.track - 1 }}{% else %}{{ col }} / span 2{% endif %}; grid-row: {{ e.row }} / span {{ e.span }}" onclick="openEvent('{{ e.id }}')">
              {% if e.bare %}
              {% if e.emoji %}<span class="emoji" aria-hidden="true">{{ e.emoji }}</span>{% endif %}{{ e.title }}
              {% else %}
              <span class="title">{% if e.emoji %}<span class="emoji" aria-hidden="true">{{ e.emoji }}</span>{% endif %}{{ e.title }}{% if e.time_in_title %} · {{ e.start }}{% endif %}{% if e.chair %} <span class="chair">(Chair: {{ e.chair }})</span>{% endif %}</span>
              {% if not e.time_in_title %}
              <span class="time">{{ e.time_label }}</span>
              {% endif %}
              {% for s in e.lines %}
              <span class="spk">{{ s }}</span>
              {% endfor %}
              {% endif %}
            </div>
            {% endfor %}
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
    <!-- ===== ORGANIZERS ===== -->
    <section id="organizers" class="band band-alt">
      <div class="wrap">
        <h2><span class="t-en">Organizers</span><span class="t-ko">조직위원회</span></h2>
        <div class="org-grid">
          {% for m in organizers.members %}
          <div class="org-card">
            {% if m.photo %}
            <img class="org-photo" src="organizers/{{ m.photo }}" alt="{{ m.name }}" loading="lazy" width="256" height="256" />
            {% else %}
            <div class="org-photo org-initials" aria-hidden="true">{{ m.initials }}</div>
            {% endif %}
            <div class="name">
              {%- if m.role %}<span class="t-en role-above"><span class="role">{{ m.role }}</span></span>{% endif -%}
              {{ t(m.name, m.name_ko) }}
              {%- if m.role %}<span class="t-ko role-beside"> <span class="role">{{ m.role_ko or m.role }}</span></span>{% endif -%}
              <span class="affil">{{ t(m.affil, m.affil_ko) }}</span>
            </div>
            {% if m.links %}
            <div class="org-links">
              {% for kind, url in m.links.items() %}
              <a href="{{ url }}" target="_blank" rel="noopener" title="{{ kind }}" aria-label="{{ m.name }} — {{ kind }}">
                <svg aria-hidden="true"><use href="#i-{{ kind }}"></use></svg>
              </a>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
    </section>
    {% if site.sponsors %}

    <!-- ===== SPONSORS =====
         Under the organisers, whose institutions these are — the two sections
         answer the same question and had a programme, a travel card and a
         poster standing between them. A section rather than a strip in the
         footer, still. In
         the footer they were chrome — 20px tall, dimmed, recoloured to one flat
         tone — which is how you show a mark you are obliged to show. Given a
         band of their own and their own colours they read as the institutions
         behind the thing. -->
    <section id="sponsors" class="band">
      <div class="wrap">
        <h2>{{ t(site.sponsors.title, site.sponsors.title_ko) }}</h2>
        <div class="sponsors-row">
          {% for h in site.sponsors.logos %}
          <a href="{{ h.url }}" target="_blank" rel="noopener" title="{{ h.name }}"
             style="--ratio: {{ h.ratio }}; --baseline: {{ h.baseline }}; --nudge: {{ h.nudge }}">
            <img src="logos/{{ h.file }}" alt="{{ h.name }}" loading="lazy" />
          </a>
          {% endfor %}
        </div>
        {% if site.sponsors.note %}
        <!-- Under the marks, not over them: the marks say who, this says under
             which grant, and nobody reads the second before the first. -->
        <p class="sponsors-grant">{{ t(site.sponsors.note, site.sponsors.note_ko) }}</p>
        {% endif %}
      </div>
    </section>
    {% endif %}

    <!-- ===== VENUE ===== -->
    <section id="venue" class="band band-alt">
      <div class="wrap">
        <h2>{{ t(venue.title, venue.title_ko) }}</h2>
        {% if venue.subtitle %}
        <p class="sub">{{ t(venue.subtitle, venue.subtitle_ko) }}</p>
        {% endif %}

        <div class="venue">
          <div class="venue-map">
            {% if venue.map.resolved == 'google' %}
            <iframe
              title="Map showing {{ venue.name }}, {{ venue.address }}"
              src="{{ venue.map.google_url }}"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
            {% elif venue.map.resolved == 'kakao_roughmap' %}
            <div id="daumRoughmapContainer{{ venue.map.kakao_roughmap.timestamp }}"
                 class="root_daum_roughmap root_daum_roughmap_landing"></div>
            {% else %}
            <div id="map" role="img" aria-label="Map showing {{ venue.name }}, {{ venue.address }}"></div>
            {% endif %}
          </div>
          <div class="venue-info">
            <div class="venue-name">{{ venue.name }} <span lang="ko">{{ venue.name_ko }}</span></div>
            <div class="venue-room">{{ venue.campus }}</div>
            <address>
              {{ venue.address }}<br />
              <span lang="ko">{{ venue.address_ko }}</span>
            </address>
            <div class="map-links">
              {% for link in venue.map_links %}
              <a href="{{ link.url }}" target="_blank" rel="noopener">
                <svg aria-hidden="true"><use href="#i-{{ link.icon }}" /></svg>{{ link.label }}</a>
              {% endfor %}
            </div>
            <!-- Rooms, transport, somewhere to sleep: three answers to three
                 questions asked in that order, and until now three different
                 shapes of answer. One row shape for all of them — the thing on
                 the left, its one number on the right, and a quieter line
                 underneath where there is more to say. A card that changes its
                 mind about how a row looks three times in three inches reads as
                 three cards that happen to be touching. -->
            {% if venue.rooms_title %}
            <h4 class="venue-h">{{ t(venue.rooms_title, venue.rooms_title_ko) }}</h4>
            {% endif %}
            <ul class="facts">
              {% for room in venue.rooms %}
              <li class="fact">
                <span class="fact-line">
                  <span class="fact-name">{% if room.icon %}<span class="fact-icon" aria-hidden="true">{{ room.icon }}</span>{% endif %}{{ room.name }}</span>
                  <span class="fact-figure">{{ room.detail }}</span>
                </span>
              </li>
              {% endfor %}
            </ul>

            {% if venue.getting_here %}
            {% if venue.getting_here_title %}
            <h4 class="venue-h">{{ t(venue.getting_here_title, venue.getting_here_title_ko) }}
              <!-- Where all three of these end. Every row is a journey to the
                   same place, and the place was named only in the card's own
                   heading two blocks up. -->
              <span class="venue-h-note"><span class="t-en">to the venue, in Naver Map</span><span class="t-ko">포스코국제관까지 · 네이버 지도</span></span>
            </h4>
            {% endif %}
            <ul class="facts">
              {% for route in venue.getting_here %}
              <li class="fact is-link">
                <a href="{{ route.url }}" target="_blank" rel="noopener"
                   aria-label="{{ route.from }} → {{ venue.name }}">
                  <span class="fact-name">{% if route.icon %}<span class="fact-icon" aria-hidden="true">{{ route.icon }}</span>{% endif %}{{ t(route.from, route.from_ko) }}</span>
                  {% if route.total %}<span class="fact-figure">{{ t(route.total, route.total_ko) }}</span>{% endif %}
                </a>
                {% if route.by or route.taxi %}
                <span class="fact-sub">{{ t(route.by, route.by_ko) }}{% if route.by and route.taxi %} · {% endif %}{{ t(route.taxi, route.taxi_ko) }}</span>
                {% endif %}
              </li>
              {% endfor %}
              {% for note in venue.getting_here_notes %}
              <li class="fact">
                <span class="fact-line">
                  <span class="fact-name">{{ t(note.label, note.label_ko) }}</span>
                  <span class="fact-figure">{{ t(note.detail, note.detail_ko) }}</span>
                </span>
              </li>
              {% endfor %}
            </ul>
            {% endif %}

            {% if venue.accommodation %}
            <h4 class="venue-h">{{ t(venue.accommodation.title, venue.accommodation.title_ko) }}
              {% if venue.accommodation.note %}
              <span class="venue-h-note">{{ t(venue.accommodation.note, venue.accommodation.note_ko) }}</span>{% endif %}
            </h4>
            {% if venue.accommodation.nearby_note %}
            <p class="facts-note">{{ t(venue.accommodation.nearby_note, venue.accommodation.nearby_note_ko) }}</p>
            {% endif %}
            <ul class="facts">
              {% for place in venue.accommodation.nearby %}
              <li class="fact{{ ' is-link' if place.map }}">
                {% if place.map %}<a href="{{ place.map }}" target="_blank" rel="noopener">{% else %}<span class="fact-line">{% endif %}
                <span class="fact-name">{% if place.icon %}<span class="fact-icon" aria-hidden="true">{{ place.icon }}</span>{% endif %}{{ t(place.name, place.name_ko) }}</span>
                <span class="fact-figure">{{ t(place.travel, place.travel_ko) }}</span>
                {% if place.map %}</a>{% else %}</span>{% endif %}
                {% if place.transit %}
                <span class="fact-sub">{{ t(place.transit, place.transit_ko) }}</span>
                {% endif %}
              </li>
              {% endfor %}
            </ul>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
    {% if site.poster %}

    <!-- ===== POSTER =====
         The printed sheet, after the travel section: by this point the page has
         said everything the poster says, so it is here as a thing to take away
         rather than as a thing to read. It links to the full-size file instead
         of shipping the 48MB print PDF into the repository. -->
    <section id="poster" class="band">
      <div class="wrap">
        <h2>{{ t(site.poster.title, site.poster.title_ko) }}{% if site.poster.title_note %}
          <span class="h2-note">({{ t(site.poster.title_note, site.poster.title_note_ko) }})</span>{% endif %}</h2>
        {% if site.poster.subtitle %}
        <p class="sub">{{ t(site.poster.subtitle, site.poster.subtitle_ko) }}</p>
        {% endif %}
        <!-- Two sheets, side by side where there is room and a swipe where
             there is not. The scroller is the same markup either way: a grid
             on a wide screen, and on a phone one column of full-width tracks
             with scroll snapping, which is the gesture a phone already has for
             "there is another one". -->
        <div class="poster-set">
          {% for sheet in site.poster.sheets %}
          <figure class="poster">
            {% if sheet.small %}
            <a class="poster-shot" href="{{ sheet.small | asset }}" target="_blank" rel="noopener">
            {% else %}
            <span class="poster-shot">
            {% endif %}
              <!-- WebP first, the PNG behind it. The sheet is a photographic
                   texture and lossless is the wrong tool for one: the same
                   1200px thumbnail is 3.6MB as PNG and 0.8MB at WebP q92, a
                   mean difference of two levels out of 255. The PNG stays as
                   the fallback. -->
              <picture>
                {% if (sheet.image[:-4] ~ '.webp') | shipped %}
                {%- set stem = sheet.image[:-4] %}
                <source type="image/webp"
                        data-srcset="{% for w in [560, 900] %}{% if (stem ~ '-' ~ w ~ '.webp') | shipped %}{{ (stem ~ '-' ~ w ~ '.webp') | asset }} {{ w }}w, {% endif %}{% endfor %}{{ (stem ~ '.webp') | asset }} 1200w"
                        sizes="(min-width: 1024px) 480px, (min-width: 781px) 470px, (min-width: 431px) 370px, 180px" />
                {% endif %}
                <img data-src="{{ sheet.image | asset }}"
                     alt="{{ site.poster.alt }}{% if sheet.label %} — {{ sheet.label }}{% endif %}"
                     width="1200" height="1698" loading="lazy" decoding="async" />
              </picture>
            {% if sheet.small %}</a>{% else %}</span>{% endif %}
            <figcaption>
              {% if sheet.label %}<span class="poster-spec">{{ t(sheet.label, sheet.label_ko) }}</span>{% endif %}
            </figcaption>
          </figure>
          {% endfor %}
        </div>
        {% if site.poster.caption %}
        <p class="poster-note">{{ t(site.poster.caption, site.poster.caption_ko) }}</p>
        {% endif %}
      </div>
    </section>
    {% endif %}
    {% if variant.candidates %}

    <!-- ===== CANDIDATES (internal build only) =====
    <section class="band">
      <div class="wrap">
        <h2>{{ candidates.title }}</h2>
        <p class="sub">{{ candidates.subtitle }}</p>
        <div class="cand-grid">
          {% for p in candidates.people %}
          <div class="cand">
            <div class="name">{{ p.name }} <em>{{ p.affil }}</em></div>
            <div class="topic">{{ p.topic }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    {% if venue.map.resolved == 'kakao_roughmap' %}
    <script charset="UTF-8" class="daum_roughmap_loader_script"
            src="https://ssl.daumcdn.net/dmaps/map_js_init/roughmapLoader.js"></script>
    <script charset="UTF-8">
      new daum.roughmap.Lander({
        timestamp: {{ venue.map.kakao_roughmap.timestamp | tojson }},
        key: {{ venue.map.kakao_roughmap.key | tojson }},
        mapWidth: "100%",
        mapHeight: "340",
      }).render();
    </script>
    {% elif venue.map.resolved == 'kakao' %}
    <script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey={{ venue.map.kakao_app_key }}"></script>
    <script>
      // Two of the heaviest things here sit a long way down the page: the map
      // and the two poster sheets. Both were being built the moment the page
      // opened — the map is a library plus a grid of tiles decoded at the
      // device's own pixel ratio, and the sheets are 1200px pictures shown at
      // 300, held whether or not anybody scrolls that far. On a phone that is
      // where the tab was being killed, and none of it is needed to read the
      // top of the page.
      //
      // loading="lazy" was already on the images and did not save them: the
      // distance at which a browser calls an image "near" is generous, and on
      // a fast connection Chrome fetches most of a page's lazy images at once.
      // Holding the URL back until the section is approached is the version
      // that actually waits.
      function whenNear(el, build) {
        if (!el) return;
        if (!window.IntersectionObserver) return build();
        // 400px of warning, so it is usually there by the time it is reached.
        var io = new IntersectionObserver(
          function (es) {
            if (!es.some(function (e) { return e.isIntersecting; })) return;
            io.disconnect();
            build();
          },
          { rootMargin: "400px" }
        );
        io.observe(el);
      }

      whenNear(document.getElementById("poster"), function () {
        var host = document.getElementById("poster");
        Array.prototype.forEach.call(
          host.querySelectorAll("[data-srcset], [data-src]"),
          function (el) {
            if (el.dataset.srcset) el.srcset = el.dataset.srcset;
            if (el.dataset.src) el.src = el.dataset.src;
          }
        );
      });
    </script>

    <script>
      // Both map libraries measure their container once, at construction, and
      // keep drawing tiles for that size. The box changes height at the 720px
      // breakpoint and on any rotate, which would otherwise leave tiles short
      // of one edge. Watch the box and let the map re-measure itself.
      function keepMapSized(remeasure) {
        var box = document.querySelector(".venue-map");
        if (!box || typeof ResizeObserver === "undefined") {
          window.addEventListener("resize", remeasure);
          return;
        }
        var pending = false;
        new ResizeObserver(function () {
          if (pending) return;
          pending = true;
          requestAnimationFrame(function () {
            pending = false;
            remeasure();
          });
        }).observe(box);
      }

      // Kakao rejects the SDK unless the app has this domain registered, and a
      // credential we cannot check from here should not leave a blank box on
      // the page. Fall back to the map that needs no credential at all.
      function mapFallback() {
        var css = document.createElement("link");
        css.rel = "stylesheet";
        css.href = "vendor/leaflet/leaflet.css";
        document.head.appendChild(css);
        var js = document.createElement("script");
        js.src = "vendor/leaflet/leaflet.js";
        js.onload = function () {
        var at = [{{ venue.lat }}, {{ venue.lon }}];
        var map = L.map("map", {
          center: at,
          zoom: {{ venue.map.zoom }},
          scrollWheelZoom: false, // don't hijack the page scroll
        });
        L.tileLayer({{ venue.map.tiles.url | tojson }}, {
          subdomains: {{ venue.map.tiles.subdomains | tojson }},
          maxZoom: {{ venue.map.tiles.max_zoom }},
          attribution: {{ venue.map.tiles.attribution | tojson }},
        }).addTo(map);
        L.marker(at, {
          icon: L.divIcon({ className: "venue-pin", iconSize: [22, 22], iconAnchor: [11, 11] }),
          keyboard: false,
        })
          .addTo(map)
          .bindTooltip({{ (venue.name_ko ~ ' · ' ~ venue.name) | tojson }}, {
            permanent: true, direction: "right", offset: [12, 0], className: "venue-tip",
          });
        map.on("click", function () { map.scrollWheelZoom.enable(); });
        keepMapSized(function () { map.invalidateSize(); });
        };
        document.body.appendChild(js);
      }

      whenNear(document.getElementById("map"), function () {
        if (typeof kakao === "undefined" || !kakao.maps) return mapFallback();
        var at = new kakao.maps.LatLng({{ venue.lat }}, {{ venue.lon }});
        var map = new kakao.maps.Map(document.getElementById("map"), {
          center: at,
          level: {{ venue.map.kakao_level }},
        });
        new kakao.maps.Marker({ map: map, position: at });
        map.addControl(new kakao.maps.ZoomControl(), kakao.maps.ControlPosition.RIGHT);
        // relayout() alone re-measures but drifts the centre off the venue.
        keepMapSized(function () { map.relayout(); map.setCenter(at); });
      });
    </script>
    {% else %}
    <script>
      // Built when the map is nearly on screen, not when the page loads. It
      // sits below the programme and the organisers, so on a phone it is a
      // long way down — and a map is the most expensive thing here: the
      // library, then a grid of tiles decoded at the device's own ratio, all
      // of it held whether or not anybody scrolls that far. Loading it on
      // approach takes that off the page's opening cost entirely.
      (function () {
        function whenNear(el, build) {
          if (!el) return;
          if (!window.IntersectionObserver) return build();
          var io = new IntersectionObserver(
            function (es) {
              if (!es.some(function (e) { return e.isIntersecting; })) return;
              io.disconnect();
              build();
            },
            { rootMargin: "400px" }
          );
          io.observe(el);
        }
        whenNear(document.getElementById("map"), function () {
          var js = document.createElement("script");
          js.src = "vendor/leaflet/leaflet.js";
          js.onload = draw;
          document.head.appendChild(js);
        });
        function draw() {
        if (typeof L === "undefined") return;
        var at = [{{ venue.lat }}, {{ venue.lon }}];
        var map = L.map("map", {
          center: at,
          zoom: {{ venue.map.zoom }},
          scrollWheelZoom: false, // don't hijack the page scroll
        });
        L.tileLayer({{ venue.map.tiles.url | tojson }}, {
          subdomains: {{ venue.map.tiles.subdomains | tojson }},
          maxZoom: {{ venue.map.tiles.max_zoom }},
          attribution: {{ venue.map.tiles.attribution | tojson }},
        }).addTo(map);

        // A marker drawn in CSS, so no icon images have to be shipped.
        L.marker(at, {
          icon: L.divIcon({
            className: "venue-pin",
            iconSize: [22, 22],
            iconAnchor: [11, 11],
          }),
          keyboard: false,
        })
          .addTo(map)
          .bindTooltip({{ (venue.name_ko ~ ' · ' ~ venue.name) | tojson }}, {
            permanent: true,
            direction: "right",
            offset: [12, 0],
            className: "venue-tip",
          });

        map.on("click", function () {
          map.scrollWheelZoom.enable();
        });
        }
      })();
    </script>
    {% endif %}

    <dialog id="event-modal" aria-label="Session detail">
      <div class="modal-head">
        <div>
          <span id="modal-badge" class="badge"></span>
          <span id="modal-when"></span>
        </div>
        <form method="dialog"><button class="modal-x" aria-label="Close">&times;</button></form>
      </div>
      <h3 id="modal-title"></h3>
      <div id="modal-body"></div>
      <!-- Both days as one ribbon, each session a slice as wide as it is long,
           with the one you are reading framed. It sits directly above the arrows
           rather than at the top of the dialog: the dialog's height changes
           with each session, so anything above the body moves under the cursor
           as you step through, while the footer stays where your hand is. -->
      <div id="modal-strip" class="day-strip modal-strip" aria-hidden="true"></div>
      <div class="modal-nav">
        <!-- No inline onclick: both buttons are wired in script so a press and
             hold can keep stepping. -->
        <button class="pill" id="modal-prev">&larr; Previous</button>
        <span id="modal-count"></span>
        <button class="pill" id="modal-next">Next &rarr;</button>
      </div>
    </dialog>

    <!-- Two windows, because they answer two questions. This one is who
         somebody is — face, name, affiliation, the paragraph about them — and
         it ends with a door to the other, which is what they are giving.
         An abstract is four hundred words about a piece of work; standing
         under a bio it made the bio look like the opening of it.

         The arrows step between speakers, not between sessions: this panel is
         deliberately off the timetable while the timetable does not say who is
         when, so there is no ribbon and no link into the grid. -->
    <dialog id="speaker-modal" aria-label="Speaker detail">
      <div class="modal-head">
        <div>
          <span class="badge"><span class="t-en">Speaker</span><span class="t-ko">연사</span></span>
        </div>
        <form method="dialog"><button class="modal-x" aria-label="Close">&times;</button></form>
      </div>
      <div id="speaker-body"></div>
      <!-- Sixteen people, and previous/next walks them one at a time. This is
           the rail the session sheet already has, in the form a list of people
           needs: one tick each, the one you are on filled, and the name of
           whichever tick is under the cursor read out above it. An A–Z index
           was the other idea and is the wrong one here — five of the sixteen
           are surnamed Lee, so the letters would point at a wall. The name
           says more than the letter and takes the same room. -->
      <div class="modal-nav">
        <button class="pill" id="spk-prev">&larr; <span class="t-en">Previous</span><span class="t-ko">이전</span></button>
        <!-- The rail sits between the arrows, at its own size. Sixteen ticks do
             not want 600px: stretched across the sheet they were forty pixels
             apart, which is a row of specks rather than a rail, and a swell
             passing through it had nothing to pass through. -->
        <span class="spk-rail" id="spk-rail">
          <span class="spk-tip" id="spk-tip"></span>
          <span class="spk-letters" id="spk-letters" aria-hidden="true"></span>
          <span class="spk-strip-bar" id="spk-strip-bar"></span>
          <span class="spk-count" id="spk-count"></span>
        </span>
        <button class="pill" id="spk-next"><span class="t-en">Next</span><span class="t-ko">다음</span> &rarr;</button>
      </div>
    </dialog>

    <!-- And the talk. It opens in place of the speaker window rather than on
         top of it: two backdrops stacked make the page behind twice as dark
         for a step that is sideways, not deeper. The way back is the first
         thing in it, and it carries the name, so the button says where it
         goes instead of only that it goes back. -->
    <dialog id="talk-modal" aria-label="Talk detail">
      <div class="modal-head">
        <div>
          <span class="badge"><span class="t-en">Talk</span><span class="t-ko">발표</span></span>
        </div>
        <form method="dialog"><button class="modal-x" aria-label="Close">&times;</button></form>
      </div>
      <div id="talk-body"></div>
    </dialog>


    <!-- ===== FOOTER =====
         Three things a reader might still want at the bottom of a page they
         have read to the end of: what this is and when, who to write to, and
         the two or three destinations that are not sections of the page. It
         was one paragraph of grey text with the addresses run together, which
         is what a footer looks like when nobody has decided what it is for. -->
    <footer class="band-alt">
      <div class="wrap footer-grid">
        <div class="footer-id">
          <p class="footer-mark">{{ wordmark(site.name) }}</p>
          <p class="footer-full">{{ site.full_name }}</p>
          <p class="footer-when">
            {{ site.venue }}, {{ site.city }}<br />
            {{ site.dates }}
          </p>
        </div>

        <div class="footer-col">
          <h4 class="footer-h"><span class="t-en">Contact</span><span class="t-ko">문의</span></h4>
          <ul class="footer-list">
            {% for who in organizers.contact %}
            <li>
              <span class="footer-name">{{ t(who.name, who.name_ko) }}{% if who.note %}
                <span class="footer-role">{{ t(who.note, who.note_ko) }}</span>{% endif %}</span>
              <a href="mailto:{{ who.email }}">{{ who.email }}</a>
            </li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-h"><span class="t-en">Elsewhere</span><span class="t-ko">바로가기</span></h4>
          <ul class="footer-list">
            {% set reg = site.hero_actions | selectattr('href') | first %}
            {% if reg and reg.href.startswith('http') %}
            <li><a href="{{ reg.href }}" target="_blank" rel="noopener">{{ t(reg.label, reg.label_ko) }}</a></li>
            {% endif %}
            <li><a href="{{ ics_file }}" download><span class="t-en">Programme (.ics)</span><span class="t-ko">일정 내려받기 (.ics)</span></a></li>
            {% if site.poster %}
            <li><a href="#poster">{{ t(site.poster.title, site.poster.title_ko) }}</a></li>
            {% endif %}
            <li><a href="#venue">{{ t(venue.title, venue.title_ko) }}</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      var LANGS = {{ about.codes | tojson }};
      function setLang(lang) {
        // Drives the whole page, not just the prose: the root attribute hides
        // the other language's chrome via CSS.
        document.documentElement.setAttribute("data-lang", lang);
        LANGS.forEach(function (code) {
          document.getElementById("about-" + code).classList.toggle("hidden", code !== lang);
        });
        try {
          localStorage.setItem("kolt-lang", lang);
        } catch (e) {
          /* private browsing — the choice just doesn't persist */
        }
      }

      function toggleLang() {
        var now = document.documentElement.getAttribute("data-lang");
        setLang(LANGS[(LANGS.indexOf(now) + 1) % LANGS.length]);
      }

      // auto -> light -> dark -> auto. "auto" removes the attribute rather
      // than writing a value, so prefers-color-scheme is what answers.
      var THEMES = [
        { id: "auto", en: "Auto", ko: "자동" },
        { id: "light", en: "Light", ko: "밝게" },
        { id: "dark", en: "Dark", ko: "어둡게" },
      ];
      function setTheme(id) {
        var t = THEMES.filter(function (x) { return x.id === id; })[0] || THEMES[0];
        var root = document.documentElement;
        if (t.id === "auto") root.removeAttribute("data-theme");
        else root.setAttribute("data-theme", t.id);
        document.getElementById("theme-icon").setAttribute("href", "#i-theme-" + t.id);
        document.getElementById("theme-en").textContent = t.en;
        document.getElementById("theme-ko").textContent = t.ko;
        document.getElementById("theme-btn").setAttribute("aria-label", "Colour theme: " + t.en);
        try {
          localStorage.setItem("kolt-theme", t.id);
        } catch (e) {
          /* ignore */
        }
      }
      // The hero is a photograph masked by a drawing, and the two themes use
      // different files for both — the light drawing places its formulas where
      // the picture is dark, because there the marks are the ink. Together
      // that is 1.2MB, and it was being fetched at the moment somebody pressed
      // the button: the mask URL went to a file that had not arrived, so the
      // mask stopped applying, the whole photograph flashed up unmasked, and
      // the hero looked like it was reloading. On a phone it was also a second
      // megabyte of drawing resident at once.
      //
      // So the theme is not applied until its pictures are in the cache. They
      // are only *pictures* — a colour scheme that waited a second would be
      // worse than a flash — so the wait is capped, and past the cap it flips
      // anyway and accepts the flash it would have had regardless.
      // Exactly the names style.css asks for, unstamped. The asset filter puts
      // a content hash on the URLs it writes, and stylesheet url()s do not go
      // through it — a stamped copy here would be a second cache entry and a
      // second download, warming nothing.
      // Keyed by theme, then by which of the two the width actually paints.
      var THEME_ART = {
        dark: {
          wide: ["hero-art.svg", "hero.jpg"],
          narrow: ["hero-art-narrow.svg", "hero.jpg"],
        },
        light: {
          wide: ["hero-art-light.svg", "hero-ink.jpg"],
          narrow: ["hero-art-light-narrow.svg", "hero-ink-narrow.jpg"],
        },
      };
      function artFor(id) {
        var m = window.matchMedia;
        if (id === "auto") id = m && m("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        var set = THEME_ART[id];
        if (!set) return [];
        return set[m && m("(max-width: 780px)").matches ? "narrow" : "wide"];
      }
      var warmed = {};
      // Ready to paint, not merely arrived. decode() is the difference between
      // the bytes being in the cache and the picture being able to go on screen
      // this frame, which is exactly the moment the drawing should come back.
      function warm(id, done) {
        var urls = artFor(id).filter(function (u) { return !warmed[u]; });
        if (!urls.length) return done();
        var left = urls.length,
          fired = false;
        var finish = function () {
          if (fired) return;
          fired = true;
          clearTimeout(cap);
          done();
        };
        // A ceiling, not a wait: nothing on screen is blocked on this, it only
        // decides how long the drawing is absent before it comes back anyway.
        var cap = setTimeout(finish, 1000);
        urls.forEach(function (u) {
          var im = new Image();
          var once = false;
          var settle = function () {
            if (once) return;
            once = true;
            warmed[u] = true;
            if (--left === 0) finish();
          };
          im.onerror = settle;
          im.onload = function () {
            // decode() is the better signal — it means the picture can go on
            // screen this frame rather than merely having arrived — but it
            // needs the page to be rasterising, and a tab that is not will
            // leave the promise unsettled. Whichever answers first.
            if (im.decode) {
              im.decode().then(settle, settle);
              setTimeout(settle, 60);
            } else {
              settle();
            }
          };
          im.src = u;
        });
      }
      // The colours change on the press. Nothing waits for a picture.
      //
      // They used to: the theme was held back until the other theme's drawing
      // was in the cache, which on a phone is 600KB of mask, and the button sat
      // there doing nothing for most of a second. Holding a whole colour scheme
      // hostage to a background texture is the wrong way round.
      //
      // So the drawing steps out of the way instead. It fades to nothing in
      // 120ms, the theme flips underneath it, and it fades back when the new
      // one can be painted. The hero keeps its photograph and its wash
      // throughout, so what a reader sees is the formulas dissolving and
      // reforming — which is a transition, where a blank flash was a fault.
      // It also means the two drawings are never both on screen: no cross-fade,
      // no second mask surface, nothing held that is not being looked at.
      var swapping = 0;
      function cycleTheme() {
        var now = document.documentElement.getAttribute("data-theme") || "auto";
        var i = THEMES.map(function (x) { return x.id; }).indexOf(now);
        var next = THEMES[(i + 1) % THEMES.length].id;
        var hero = document.querySelector(".hero");
        var same = artFor(next).join() === artFor(now).join();
        // auto -> light with the system already light changes no picture at
        // all, and fading one out to bring the same one back is a flicker
        // bought for nothing.
        if (!hero || same) return setTheme(next);
        // Both in the same tick: the drawing is hidden and the theme applied
        // before the browser paints either, so there is no frame in which a
        // half-loaded mask can be seen and no wait before the colours change.
        hero.classList.add("art-swap");
        setTheme(next);
        // Only the most recent press may bring the drawing back. Pressed twice
        // quickly, the first swap's pictures arrive while the second is still
        // fetching, and without this the drawing would return as the one the
        // reader has already moved past.
        var mine = ++swapping;
        warm(next, function () {
          if (mine === swapping) hero.classList.remove("art-swap");
        });
      }
      // And when nothing else is going on, put the other theme's pictures in
      // the cache, so that fade is usually over before it is noticed. As bytes
      // and not as pictures: fetch() fills the cache without decoding anything,
      // which is the whole difference between a warm cache and a second copy of
      // a drawing sitting in memory for a button nobody has pressed.
      //
      // Not on a metered connection and not when the reader has asked for less
      // data: that is not a trade to make on their behalf.
      (function () {
        var c = navigator.connection || {};
        if (c.saveData || /(^|[^4])[23]g/.test(c.effectiveType || "")) return;
        if (!window.fetch) return;
        // Straight after load rather than a few seconds into idle. The wait it
        // removes is the one a reader feels — press the theme button before
        // this has run and the drawing is away for as long as the fetch takes
        // — and the number it was being held back for turned out to be wrong:
        // the mask is 124KB over the wire, not the 600KB it is on disk, so the
        // pair is about 250KB rather than the megabyte this was written for.
        var idle = window.requestIdleCallback || function (f) { setTimeout(f, 200); };
        window.addEventListener("load", function () {
          setTimeout(function () {
            idle(function () {
              // The opposite of what is on screen, and only that. Auto is not a
              // third set of pictures — it is one of these two — so warming all
              // three entries would fetch one of them twice.
              var m = window.matchMedia;
              var showing = document.documentElement.getAttribute("data-theme");
              if (!showing) showing = m && m("(prefers-color-scheme: dark)").matches ? "dark" : "light";
              artFor(showing === "dark" ? "light" : "dark").forEach(function (u) {
                fetch(u, { cache: "force-cache", priority: "low" }).catch(function () {});
              });
            });
          }, 200);
        });
      })();
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("kolt-theme");
        } catch (e) {
          /* ignore */
        }
        setTheme(saved || "auto");
      })();

      // The same hiding, on the way in. A mask that has not arrived yet is not
      // a mask: the layer draws unmasked until the file lands, so the hero
      // opened with the whole photograph showing through and then snapped to
      // formulas — which reads as the drawing loading slowly when what was
      // slow was watching it arrive.
      //
      // Hidden by script rather than in the stylesheet, so a reader without
      // JavaScript gets the drawing rather than a permanently blank layer, and
      // released by the same cap as a theme change: 1000ms and it comes back
      // regardless.
      (function () {
        var hero = document.querySelector(".hero");
        if (!hero || !hero.querySelector(".hero-art")) return;
        var now = document.documentElement.getAttribute("data-theme") || "auto";
        hero.classList.add("art-swap");
        var mine = ++swapping;
        warm(now, function () {
          if (mine === swapping) hero.classList.remove("art-swap");
        });
      })();

      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("kolt-lang");
        } catch (e) {
          /* ignore */
        }
        var wanted = saved || (navigator.language || "").slice(0, 2);
        setLang(LANGS.indexOf(wanted) >= 0 ? wanted : LANGS[0]);
      })();

      {%- if site.hero_background == 'drift' %}
      // ---- Formulas tiled across the hero
      //
      // A tight grid, tilted to the same angle as the hatch, drifting along its
      // own diagonal. Two identical halves stacked, translated by exactly half
      // the field per cycle, so the loop has no seam.
      //
      // The sprite is ~65 KB gzipped — more than the page — so it is fetched
      // after load rather than inlined, and the hero is complete without it.
      (function () {
        var FORMULAS = {{ formulas | tojson }};
        var box = document.querySelector(".hero-math");
        if (!box || !FORMULAS.length) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        // ~130 KB gzipped of vector outlines, for decoration. Skipped only when
        // the reader has actually asked to save data — a small screen is not on
        // its own a reason to withhold it.
        var link = navigator.connection;
        if (link && (link.saveData || /2g/.test(link.effectiveType || ""))) return;

        fetch("formulas.svg")
          .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
          .then(function (svg) {
            document.body.insertAdjacentHTML("beforeend", svg);

            var pool = FORMULAS.slice().sort(function () { return Math.random() - 0.5; });
            var n = 0;
            function next() { return pool[n++ % pool.length]; }

            // The field is rotated, so it has to be far larger than the hero to
            // cover the corners; these counts fill that oversized box.
            //
            // Each row slides along the tilt's own -X axis, which lands as
            // down-and-left on screen. Every cell is the same width, so one
            // shift distance serves every row and they all travel at the same
            // speed — a shower, not a race.
            var SCALE = 0.5;   // path units -> px; one constant for every formula
            var GAP = 26;      // matches .fx-row's gap
            var ROW_GAP = 10;  // matches .fx-tilt's gap
            var SPEED = 26;    // px per second, the same in every row

            // A row is as tall as its tallest cell, and with a hundred formulas
            // in the pool every row draws at least one fraction or integral — so
            // left alone, every row is as tall as the tallest formula in the set
            // and the field reads as widely spaced lines of mostly short maths.
            //
            // So rows get a fixed height instead, set here from the distribution
            // of the formulas themselves. The tall minority overflows it and
            // laps a little into its neighbours, which is what a tight comb of
            // maths actually looks like — the alternative is spacing every row
            // for a formula that is not in it.
            var ROW_H = (function () {
              var hs = FORMULAS.map(function (f) { return f.h * SCALE; })
                               .sort(function (a, b) { return a - b; });
              return Math.round(hs[Math.floor(hs.length * 0.55)]);
            })();

            var builtW = 0, builtH = 0;
            function build() {
              // The field is rotated 45°, so covering a W x H hero needs a
              // square of side (W + H) / sqrt(2) — the diagonal extent of the
              // area, measured along the tilted axes. Everything below is sized
              // from that, so the field fills whatever window it is given.
              var W = box.offsetWidth, H = box.offsetHeight;
              // Rebuilding rewrites every node, which restarts every animation
              // — the field visibly jumps. So only do it when the hero's box has
              // actually changed. Browsers fire resize for things that are not
              // resizes (a scrollbar appearing, a phone's URL bar sliding away),
              // and without this guard those looked like the page reloading.
              if (W === builtW && H === builtH) return;
              builtW = W;
              builtH = H;

              // Overscan on every side. Without it a wrapping formula reappears
              // exactly at the field's edge, which is the hero's edge — so it
              // pops into existence instead of drifting in. One widest-formula
              // of margin means the wrap always happens out of sight.
              var widest = FORMULAS.reduce(function (m, f) { return Math.max(m, f.w * SCALE); }, 0);
              var overscan = widest + 120;
              var side = (W + H) / Math.SQRT2 + overscan * 2;

              var stride = ROW_H + ROW_GAP;
              var rowCount = Math.ceil(side / stride) + 2;   // +2 so the edges are never bare

              var rows = "";
              for (var r = 0; r < rowCount; r++) {
                // Fill one half of the row until it spans the field, then repeat
                // it: the copy is what covers the gap the first leaves behind.
                var picks = [], halfWidth = 0;
                while (halfWidth < side) {
                  var f = next();
                  picks.push(f);
                  halfWidth += f.w * SCALE + GAP;
                }
                var cells = "";
                for (var pass = 0; pass < 2; pass++) {
                  for (var i = 0; i < picks.length; i++) {
                    var g = picks[i];
                    cells +=
                      '<svg class="fx" style="width:' + (g.w * SCALE).toFixed(1) + 'px" viewBox="0 0 ' +
                      g.w + " " + g.h + '"><use href="#' + g.id + '" width="' + g.w +
                      '" height="' + g.h + '"/></svg>';
                  }
                }
                // Rows differ in width now that every formula keeps its own size,
                // so the duration is derived from the distance — same pixels per
                // second everywhere, which is what makes it read as one field.
                rows +=
                  '<div class="fx-row" style="height:' + ROW_H +
                  "px;--shift:" + (-halfWidth).toFixed(1) +
                  "px;animation-duration:" + (halfWidth / SPEED).toFixed(1) +
                  "s;animation-delay:" + (-r * 2.3).toFixed(1) + 's">' + cells + "</div>";
              }

              box.innerHTML =
                '<div class="fx-tilt" style="width:' + side.toFixed(0) + "px;height:" +
                side.toFixed(0) + 'px">' + rows + "</div>";
            }

            build();
            // Watch the hero itself rather than the window: a ResizeObserver
            // reports the element's own box, so it stays quiet during scrolling.
            // Still debounced — dragging a window edge fires continuously.
            var pending;
            var rerun = function () {
              clearTimeout(pending);
              pending = setTimeout(build, 250);
            };
            if (window.ResizeObserver) new ResizeObserver(rerun).observe(box);
            else window.addEventListener("resize", rerun);
          })
          .catch(function () { /* decoration only — leave the hero as it is */ });
      })();
      {%- endif %}

      // D-day, Korean convention: the day itself is D-DAY, the day before D-1.
      // Computed from calendar dates in the reader's own zone, not from a
      // millisecond difference, so it does not tick over at the wrong hour.
      (function () {
        var el = document.querySelector(".dday");
        if (!el || !el.dataset.from) return;
        var p = el.dataset.from.split("-");
        var start = new Date(+p[0], +p[1] - 1, +p[2]);
        var now = new Date();
        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        var days = Math.round((start - today) / 86400000);
        el.textContent = days > 0 ? " (D-" + days + ")" : days === 0 ? " (D-DAY)" : " (D+" + -days + ")";
      })();

      var VIEWS = ["grid", "list", "abstracts", "now"];
      function setView(view) {
        VIEWS.forEach(function (name) {
          var on = name === view;
          document.getElementById("view-" + name).classList.toggle("hidden", !on);
          document.getElementById("view-btn-" + name).classList.toggle("active", on);
        });
        document.getElementById("day-pills").classList.toggle("hidden", view === "grid" || view === "now");
        if (view === "now") renderNow();
        try {
          localStorage.setItem("kolt-view", view);
        } catch (e) {
          /* private browsing — the choice just doesn't persist */
        }
      }

      // ---- Reveal blocks as they scroll into view
      (function () {
        var still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (still || !window.IntersectionObserver) return;

        // Skip anything inside a container that can be display:none — the
        // programme views and the inactive language block. The observer never
        // fires for a hidden element, so it would still be at opacity 0 when
        // the reader switched to it. Those containers animate on switch anyway.
        var targets = Array.prototype.slice
          .call(
            document.querySelectorAll(
              // .sponsors-row is deliberately absent. It is the last thing on the page, and
              // a reveal holds it 12px lower than its layout position until it fires —
              // a transform does not move the layout box but it does extend the
              // scrollable area, so the page scrolled past its own end by exactly that
              // much. A logo strip is not worth it.
              ".band h2, .about-block, .venue, .org-card, .spk-card"
            )
          )
          .filter(function (el) {
            return !el.closest("#view-grid, #view-list, #view-abstracts, #view-now, .about");
          });

        targets.forEach(function (el) {
          el.classList.add("reveal");
        });

        // Scroll-driven animation, where it exists, ties progress to scroll
        // position and runs off the compositor. The observer is then not just
        // redundant but wrong — it would latch the block visible at the first
        // intersection and the scrub would have nothing left to do.
        if (window.CSS && CSS.supports && CSS.supports("animation-timeline", "view()")) {
          document.documentElement.classList.add("scrub");
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              // Stagger within a row of siblings so a grid arrives in sequence
              // rather than all at once, capped so nothing waits noticeably.
              var peers = Array.prototype.slice.call(el.parentElement.children);
              var i = Math.min(peers.indexOf(el), 4);
              el.style.transitionDelay = i * 60 + "ms";
              el.classList.add("in");
              io.unobserve(el);
              seen.set(el, true);
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.05 }
        );
        targets.forEach(function (el) {
          io.observe(el);
        });
      })();

      // ---- Highlight the section the reader is currently in
      (function () {
        // The phone bar scrolls sideways and holds more tabs than fit, so the
        // highlighted one can sit off-screen — reaching the bottom of the page
        // marks "Travel Info" current while it is still past the right edge.
        // scrollLeft is set directly rather than using scrollIntoView, which
        // would also move the page vertically and fight the scroll that
        // triggered it.
        function revealCurrentTab() {
          var bar = document.querySelector(".tabs-mobile");
          if (!bar || bar.scrollWidth <= bar.clientWidth) return;
          var link = bar.querySelector("a.current");
          if (!link) return;
          var pad = 20; // keep the pill clear of the edge rather than flush to it
          var left = link.offsetLeft - pad;
          var right = link.offsetLeft + link.offsetWidth + pad;
          if (left < bar.scrollLeft) bar.scrollTo({ left: left, behavior: "smooth" });
          else if (right > bar.scrollLeft + bar.clientWidth)
            bar.scrollTo({ left: right - bar.clientWidth, behavior: "smooth" });
        }

        var links = Array.prototype.slice.call(document.querySelectorAll(".tabs a, .tabs-mobile a"));
        var sections = links
          .map(function (a) {
            return document.querySelector(a.getAttribute("href"));
          })
          .filter(Boolean);
        if (!sections.length || !window.IntersectionObserver) return;

        var visible = new Set();
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) visible.add(entry.target.id);
              else visible.delete(entry.target.id);
            });
            var inBand = sections.filter(function (s) {
              return visible.has(s.id);
            });
            // The last one in the band, not the first. With the first, a
            // section stayed current until its own tail left the band — which
            // happens only once the next section's heading has reached the top
            // of the screen. So the tab lit up a full screen after the section
            // it names had taken the page over. Taking the last one hands off
            // as soon as the incoming section crosses the band's lower edge, at
            // which point it already fills the bottom half of the viewport.
            var top = inBand[inBand.length - 1];
            links.forEach(function (a) {
              a.classList.toggle("current", !!top && a.getAttribute("href") === "#" + top.id);
            });
            if (top) revealCurrentTab();
          },
          { rootMargin: "-76px 0px -55% 0px" }
        );
        sections.forEach(function (s) {
          observer.observe(s);
        });
      })();

      // ---- Where an anchor jump lands
      // Separate from the highlighting above on purpose: which tab lights up is
      // a question about what you are reading, and this is a question about
      // where a click puts you. They should not be able to drift apart.
      //
      // scroll-margin-top positions the section's *box*, and the section's own
      // top padding then sits between that edge and the heading — 64px of it —
      // so a jump left the title a third of the way down the screen under a
      // bar that is only 61px tall. Measured rather than assumed: the bar has
      // no fixed height, it changes with the language and the breakpoint.
      (function () {
        var bar = document.querySelector(".topbar");
        var sections = document.querySelectorAll("section[id]");
        if (!bar || !sections.length) return;
        var GAP = 18; // between the bottom of the bar and the top of the heading

        // Layout position, walking offsetParents. A client rect would do the
        // same job in one call, but every band heading is a reveal target and
        // an unfired reveal holds it 12px below where it will settle — so a
        // rect measures the animation, not the layout, and which sections were
        // already revealed when this ran would decide where the anchor landed.
        // offsetTop ignores transforms.
        function layoutTop(el) {
          var y = 0;
          while (el) {
            y += el.offsetTop;
            el = el.offsetParent;
          }
          return y;
        }

        function fitAnchors() {
          var barH = bar.getBoundingClientRect().height;
          sections.forEach(function (s) {
            // The heading's own offset inside the section, not the section's
            // padding: headings carry a top margin on top of it.
            var h = s.querySelector("h2");
            var lead = h ? layoutTop(h) - layoutTop(s) : 0;
            s.style.scrollMarginTop = Math.round(barH + GAP - lead) + "px";
          });
        }

        fitAnchors();
        // The bar's height changes with the language toggle and at breakpoints;
        // the padding changes at breakpoints too, which a bar observer alone
        // would miss.
        addEventListener("resize", fitAnchors);
        if (window.ResizeObserver) new ResizeObserver(fitAnchors).observe(bar);
      })();

      // ---- Clearance for the fixed tab bar
      //
      // The bar is pinned over the bottom of the viewport, so the page needs
      // that much padding under it or the last line sits behind the bar. The
      // padding used to be a number in the stylesheet — 58px against a bar that
      // measures 53 — and the five it was out by was scrollable emptiness under
      // the footer. Any change to the bar's type, padding or safe-area inset
      // moved one of the two numbers and not the other.
      //
      // So the bar reports its own height and the padding is that. One fact,
      // one source, and it cannot drift: whatever the bar becomes, the page
      // follows it on the same frame. The stylesheet keeps a fallback for the
      // case where this never runs.
      (function () {
        var bar = document.querySelector(".tabs-mobile");
        if (!bar) return;
        function syncClearance() {
          // display:none above the breakpoint, where the page needs no
          // clearance at all and offsetHeight is already 0.
          document.documentElement.style.setProperty(
            "--tabbar-h", bar.offsetHeight + "px");
        }
        syncClearance();
        addEventListener("resize", syncClearance);
        addEventListener("orientationchange", syncClearance);
        if (window.ResizeObserver) new ResizeObserver(syncClearance).observe(bar);
      })();

      // ---- Day filter (list view; the grid always shows every day side by side)
      function setDay(day) {
        document.querySelectorAll("#day-pills button").forEach(function (b) {
          b.classList.toggle("active", b.dataset.day === day);
        });
        // Both linear views carry the same data-day, and the pills are shown
        // for both — filtering only the list left the abstracts ignoring them.
        document.querySelectorAll(".agenda, .abs-day").forEach(function (block) {
          block.classList.toggle("hidden", day !== "all" && block.dataset.day !== day);
        });
      }

      // On the day itself, start filtered to that day — that is the only day
      // anyone standing in the room cares about. Before and after, show both.
      (function () {
        var now = new Date();
        var today = [
          now.getFullYear(),
          ("0" + (now.getMonth() + 1)).slice(-2),
          ("0" + now.getDate()).slice(-2),
        ].join("-");
        var match = null;
        document.querySelectorAll("#day-pills button[data-date]").forEach(function (b) {
          if (b.dataset.date === today) match = b.dataset.day;
        });
        if (match !== null) setDay(match);
      })();

      // ---- "Now" is a view: one slab for what is on, a thin queue for the rest.
      function nowSlices() {
        var t = Date.now();
        var live = null, next = [];
        EVENTS.forEach(function (e) {
          var from = Date.parse(e.begins), to = Date.parse(e.ends);
          if (!live && t >= from && t < to) live = e;
          else if (t < from) next.push(e);
        });
        // Hand the clock back too — the progress bar has to measure against the
        // same instant this was decided on, not a second reading of the clock.
        return { t: t, live: live, lead: live || next.shift() || null, next: next.slice(0, 3) };
      }

      function renderNow() {
        var s = nowSlices();
        var box = document.getElementById("view-now");
        if (!s.lead) {
          box.innerHTML = '<p class="now-note">The programme has finished — see you at the next edition.</p>';
          box.classList.remove("is-pending");
          return;
        }

        var e = s.lead;
        var span = e.time.split(" – ");
        // The full block, not the one-liner: whoever is on stage right now is
        // exactly who you want a bio and a slide link for, without having to
        // open the session first.
        var who = '<div class="now-people">' +
          e.speakers.map(function (sp) { return speakerHtml(sp, true); }).join("") + "</div>";

        // How far into the session we are — the one number a "now" view owes
        // you that the programme itself cannot show.
        var from = Date.parse(e.begins), to = Date.parse(e.ends);
        var pct = s.live ? Math.min(100, Math.max(0, ((s.t - from) / (to - from)) * 100)) : 0;

        var facts = [["Day", e.dayShort], ["Duration", e.duration], ["Session", e.typeLabel]];
        if (e.chair) facts.push(["Chair", e.chair]);

        // Before the first session, say so plainly and count down to it. The
        // hatch alone tells you the view is inactive; this tells you for how
        // much longer.
        var head = !s.live
          ? '<div class="now-pending">' +
            '<b><span class="t-en">Not started yet</span><span class="t-ko">아직 시작 전</span></b>' +
            '<span id="now-countdown" data-begins="' + esc(e.begins) + '"></span>' +
            "</div>"
          : "";

        var out =
          '<div class="now-card">' + head +
          '<article class="now-lead' + (s.live ? " is-live" : "") + '" onclick="openEvent(\'' + e.id + "')\">" +
          '<span class="now-label">' + (s.live ? "Happening now" : "Opens the programme") + "</span>" +
          '<div class="now-rail">' +
          '<div class="now-time">' + esc(span[0]) + "</div>" +
          // The empty track, not a hairline: the bar is part of the layout
          // whether or not it has progress to report yet.
          '<div class="now-track' + (s.live ? "" : " is-todo") + '">' +
          '<div class="now-fill" style="width:' + pct.toFixed(1) + '%"></div></div>' +
          '<div class="now-time">' + esc(span[1] || "") + "</div>" +
          "</div>" +
          "<h4>" + mark(e) + esc(e.title) + "</h4>" +
          who +
          '<div class="now-facts">' +
          facts
            .map(function (f) {
              return "<div><span>" + esc(f[0]) + "</span>" + esc(f[1]) + "</div>";
            })
            .join("") +
          "</div>" +
          // The same ribbon the session dialog carries, so "where in the two
          // days" reads the same way wherever you are looking at it.
          '<div class="day-strip now-strip" aria-hidden="true">' + stripHtml(e) + "</div>" +
          "</article></div>";

        if (s.next.length) {
          out +=
            '<div class="now-queue"><span class="now-label">Up next</span>' +
            s.next
              .map(function (n) {
                return (
                  '<button class="now-row" onclick="openEvent(\'' + n.id + "')\">" +
                  "<span>" + esc(n.time.split(" – ")[0]) + "</span>" + mark(n) + esc(n.title) + "</button>"
                );
              })
              .join("") +
            "</div>";
        }
        box.innerHTML = out;
        box.classList.toggle("is-pending", !s.live);
        tickCountdown();
      }

      // Ticks once a second while the pending badge is on screen, and stops
      // itself the moment it isn't — no timer left running behind a view you
      // are not looking at.
      var countdownTimer = null;
      function tickCountdown() {
        var el = document.getElementById("now-countdown");
        // Switching views leaves the markup in place, just hidden — so the
        // element still exists and checking for it alone is not enough to know
        // anyone is looking.
        var showing = el && !document.getElementById("view-now").classList.contains("hidden");
        if (!showing) {
          if (countdownTimer) countdownTimer = clearInterval(countdownTimer);
          return;
        }
        var left = Date.parse(el.dataset.begins) - Date.now();
        if (left <= 0) return renderNow(); // it started while we were watching
        var d = Math.floor(left / 86400000);
        var h = Math.floor(left / 3600000) % 24;
        var m = Math.floor(left / 60000) % 60;
        var sec = Math.floor(left / 1000) % 60;
        var pad = function (n) { return n < 10 ? "0" + n : String(n); };
        // One form for both languages — a clock reading needs no translating,
        // and the D-number is read the same way either side.
        el.textContent = "D-" + d + " " + pad(h) + ":" + pad(m) + ":" + pad(sec);
        if (!countdownTimer) countdownTimer = setInterval(tickCountdown, 1000);
      }

      // ---- Session detail, walkable with the arrows or the arrow keys
      var EVENTS = {{ detail | tojson }};

      // Restoring the view has to come after EVENTS is assigned. It used to run
      // above: `var EVENTS` is hoisted but still undefined that early, so
      // reloading with Now selected threw inside renderNow and left the panel
      // blank — the card simply vanished.
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("kolt-view");
        } catch (e) {
          /* ignore */
        }
        // The grid needs {{ grid.min_width }} to be readable, so narrow screens start on the list.
        var narrow = window.matchMedia("(max-width: 720px)").matches;
        setView(saved || (narrow ? "list" : "grid"));
      })();
      var MODAL = document.getElementById("event-modal");
      var at = 0;

      function esc(s) {
        var d = document.createElement("div");
        d.textContent = s == null ? "" : s;
        return d.innerHTML;
      }

      function speakerLine(s) {
        var name = s.home
          ? '<a href="' + esc(s.home) + '" target="_blank" rel="noopener">' + s.nameHtml + "</a>"
          : s.nameHtml;
        var line = "<b>" + name + "</b>";
        if (s.affil) line += " <em>" + s.affilHtml + "</em>";
        if (s.topic) line += " · " + esc(s.topic);
        return line;
      }

      function mark(e) {
        return e.emoji ? '<span class="emoji" aria-hidden="true">' + esc(e.emoji) + "</span>" : "";
      }

      // Both languages, switched by CSS like everything else on the page.
      function tbd(en, ko) {
        return '<span class="t-en">' + esc(en) + '</span><span class="t-ko">' + esc(ko) + "</span>";
      }

      function speakerHtml(s, compact) {
        var head = s.photo
          ? '<img class="sp-photo" src="' + esc(s.photo) + '" alt="" loading="lazy" />'
          : '<div class="sp-photo sp-blank" aria-hidden="true"></div>';
        var name = s.home
          ? '<a href="' + esc(s.home) + '" target="_blank" rel="noopener">' + s.nameHtml + "</a>"
          : s.nameHtml;
        var bits = '<div class="sp-name">' + name;
        if (s.affil) bits += " <em>" + s.affilHtml + "</em>";
        bits += "</div>";
        if (s.talk) bits += '<div class="sp-talk">' + esc(s.talk) + "</div>";
        else if (s.topic) bits += '<div class="sp-talk">' + esc(s.topic) + "</div>";
        else bits += '<div class="sp-talk is-todo">' + tbd("Talk title to be announced", "발표 제목 미정") + "</div>";

        bits += s.bio
          ? '<div class="sp-bio">' + s.bio + "</div>"
          : '<div class="sp-bio is-todo">' + tbd("Speaker bio to be added", "연사 소개 준비 중") + "</div>";

        if (!compact)
          bits += s.abstract
            ? '<div class="sp-abstract">' + s.abstract + "</div>"
            : '<div class="sp-abstract is-todo">' + tbd("Abstract to be announced", "초록 준비 중") + "</div>";

        bits += s.slides
          ? '<a class="sp-slides" href="' + esc(s.slides) + '" target="_blank" rel="noopener">' +
            tbd("Slides (PDF)", "발표자료 (PDF)") + "</a>"
          : '<span class="sp-slides is-todo">' + tbd("Slides after the talk", "발표 후 자료 공개") + "</span>";
        return '<div class="sp">' + head + "<div>" + bits + "</div></div>";
      }

      // Each day is its own flex row, and a slice grows in proportion to its
      // own minutes — so the ribbon is a true scale drawing of the timetable,
      // not a row of equal chips.
      function stripHtml(current) {
        var days = [];
        // Carry each slice's index in EVENTS, so the ribbon can be scrubbed
        // without matching back by id on every pointer move.
        EVENTS.forEach(function (ev, i) {
          var d = days.filter(function (x) { return x.name === ev.dayShort; })[0];
          if (!d) days.push((d = { name: ev.dayShort, events: [] }));
          d.events.push({ ev: ev, i: i });
        });
        return days
          .map(function (d) {
            var slices = d.events
              .map(function (item) {
                var ev = item.ev;
                var mins = (Date.parse(ev.ends) - Date.parse(ev.begins)) / 60000;
                return (
                  '<i class="strip-slice strip-' + ev.type + (ev.id === current.id ? " is-current" : "") +
                  '" data-i="' + item.i + '" style="flex-grow:' + mins + '"></i>'
                );
              })
              .join("");
            return '<span class="strip-day"><b>' + esc(d.name) + "</b>" +
                   '<span class="strip-bar">' + slices + "</span></span>";
          })
          .join("");
      }

      function renderEvent() {
        var e = EVENTS[at];
        document.getElementById("modal-strip").innerHTML = stripHtml(e);
        var badge = document.getElementById("modal-badge");
        badge.textContent = e.typeLabel;
        badge.className = "badge badge-" + e.type;
        document.getElementById("modal-when").textContent =
          e.day + " · " + e.time + " · " + e.duration;
        document.getElementById("modal-title").innerHTML =
          mark(e) + esc(e.title) + (e.chair ? "  (Chair: " + esc(e.chair) + ")" : "");

        var body = e.speakers.map(speakerHtml).join("");
        body += e.notes.map(function (n) {
          return '<p class="sp-note">' + esc(n) + "</p>";
        }).join("");
        document.getElementById("modal-body").innerHTML =
          body || '<p class="sp-note">No further detail yet.</p>';

        document.getElementById("modal-count").textContent = at + 1 + " / " + EVENTS.length;
        document.getElementById("modal-prev").disabled = at === 0;
        document.getElementById("modal-next").disabled = at === EVENTS.length - 1;
      }

      function stepEvent(by) {
        var next = at + by;
        if (next < 0 || next >= EVENTS.length) return;
        at = next;
        renderEvent();
      }

      // ---- Scrub the ribbon
      // The two-day ribbon already says where you are in the programme; this
      // lets you say it back. Press anywhere along it and the dialog goes to
      // that session; keep the finger down and drag, and it follows.
      //
      // It stays aria-hidden and unfocusable: this is a pointer shortcut laid
      // over the arrows and the ArrowLeft/ArrowRight keys, which remain the
      // accessible path through the programme.
      (function () {
        var strip = document.getElementById("modal-strip");
        if (!strip) return;
        var spans = null,
          dragging = false;

        // Measured once per press. renderEvent() rewrites the ribbon on every
        // step, but the current slice is marked with a box-shadow rather than a
        // size, so the geometry underneath the finger does not move.
        function measure() {
          spans = [].map.call(strip.querySelectorAll(".strip-slice"), function (el) {
            var r = el.getBoundingClientRect();
            return { i: +el.dataset.i, left: r.left, right: r.right };
          });
        }

        // x alone decides it: both days sit on one row. Falling back to the
        // nearest slice means the gap around the DAY 2 label, and any overshoot
        // past either end, still lands somewhere sensible rather than nowhere.
        function pick(x) {
          var best = -1,
            bestGap = Infinity;
          for (var k = 0; k < spans.length; k++) {
            var s = spans[k];
            if (x >= s.left && x < s.right) return s.i;
            var gap = x < s.left ? s.left - x : x - s.right;
            if (gap < bestGap) {
              bestGap = gap;
              best = s.i;
            }
          }
          return best;
        }

        function scrubTo(x) {
          if (!spans || !spans.length) return;
          var i = pick(x);
          if (i < 0 || i === at) return;
          at = i;
          renderEvent();
        }

        strip.addEventListener("pointerdown", function (ev) {
          measure();
          dragging = true;
          // Captured on the ribbon itself, not the slice: the slices are
          // replaced on every step, and a capture held by one of them would die
          // with it on the first move.
          try {
            strip.setPointerCapture(ev.pointerId);
          } catch (e) {
            /* older pointer implementations */
          }
          scrubTo(ev.clientX);
          ev.preventDefault();
        });
        strip.addEventListener("pointermove", function (ev) {
          if (dragging) scrubTo(ev.clientX);
        });
        ["pointerup", "pointercancel"].forEach(function (type) {
          strip.addEventListener(type, function (ev) {
            dragging = false;
            try {
              strip.releasePointerCapture(ev.pointerId);
            } catch (e) {
              /* already released */
            }
          });
        });
      })();

      // Hold either arrow to keep going. Twenty-odd sessions, and sixteen
      // speakers, are both far enough that reaching the other end should not be
      // twenty taps.
      //
      // The first step is still the click, so a tap is exactly one step and the
      // keyboard path (Enter/Space, which fire click with no pointer events at
      // all) is untouched. Only once the press outlasts a tap does it start
      // repeating, accelerating from a readable pace to a fast one — a fixed
      // fast rate overshoots, and a fixed slow one is not worth holding.
      //
      // `step` moves by one, `where` says where it ended up, and the two of
      // them are how the repeat knows it has run out of list.
      function holdToRepeat(pairs, step, where, modal) {
        var HOLD_DELAY = 420; // a press longer than this is a hold, not a tap
        // Measured against the programme's own length: this crosses all 21
        // sessions in about three and a half seconds. Faster than that and the
        // titles are a blur you cannot stop on.
        var FIRST = 240,
          FASTEST = 110,
          RAMP = 0.86;
        var timer = null,
          lastRepeat = 0;

        function stop() {
          clearTimeout(timer);
          timer = null;
        }

        function begin(by, btn) {
          var wait = FIRST;
          (function schedule(delay) {
            timer = setTimeout(function () {
              var before = where();
              step(by);
              // Either end of the list, or the button went disabled under the
              // finger — stop rather than spin.
              if (where() === before || btn.disabled) return stop();
              lastRepeat = Date.now();
              // Scheduled at the current pace and then quickened, not the
              // other way round: ramping first meant FIRST was never actually
              // waited — the first repeat came 206ms after the delay rather
              // than the 240 it is written as.
              schedule(wait);
              wait = Math.max(FASTEST, wait * RAMP);
            }, delay);
          })(HOLD_DELAY);
        }

        pairs.forEach(function (pair) {
          var btn = document.getElementById(pair[0]),
            by = pair[1];
          btn.addEventListener("pointerdown", function () {
            begin(by, btn);
          });
          ["pointerup", "pointercancel", "pointerleave"].forEach(function (ev) {
            btn.addEventListener(ev, stop);
          });
          btn.addEventListener("click", function () {
            // The click that ends a hold would otherwise add one more step.
            // Timestamped rather than flagged: a flag set by a press that ended
            // off the button never gets cleared, and swallows the next tap.
            if (Date.now() - lastRepeat < 400) return;
            step(by);
          });
        });

        // Releasing outside the dialog, or closing it mid-hold, must not leave
        // the timer running.
        modal.addEventListener("close", stop);
        addEventListener("pointerup", stop);
        addEventListener("blur", stop);
      }

      // And a swipe across the sheet, which is the arrows without the arrows.
      // The card under the finger goes with it and the sheet's furniture does
      // not: the head, the rail and the arrows are the frame, and it is the
      // page inside them that turns.
      //
      // Touch only. A mouse dragging left across a paragraph is selecting it,
      // and a trackpad's two fingers arrive as wheel events rather than as
      // this, so neither can turn a page by accident.
      //
      // The first dozen pixels decide whose gesture it is. Past that it is
      // either horizontal and ours — and the panel must not scroll under it,
      // which is what preventDefault and touch-action: pan-y between them
      // arrange — or it is the reader scrolling, and we never hear about it
      // again. The axis test is 1.4 rather than 1: a gesture only just more
      // sideways than it is downward is a thumb travelling in an arc.
      function swipeToStep(sheet, step, o) {
        o = o || {};
        var cards = o.cards || [];
        var MIN = 12, COMMIT = 56, OUT = 170, IN = 230;
        var still = matchMedia("(prefers-reduced-motion: reduce)");
        var id = null, x0 = 0, y0 = 0, axis = 0, busy = false;

        // The end of the list is the disabled arrow, which the sheet already
        // works out for itself every time it steps.
        function canStep(dir) {
          var btn = document.getElementById(dir < 0 ? o.prev : o.next);
          return !btn || !btn.disabled;
        }
        function place(dx, ms) {
          var span = sheet.getBoundingClientRect().width || 1;
          cards.forEach(function (el) {
            el.style.transition = ms
              ? "transform " + ms + "ms cubic-bezier(0.22, 1, 0.36, 1), opacity " + ms + "ms ease"
              : "none";
            el.style.transform = dx ? "translate3d(" + dx + "px,0,0)" : "";
            // Fading as it goes, so the card leaves rather than slides under
            // the edge of a window it is the same colour as.
            el.style.opacity = dx ? Math.max(0, 1 - Math.abs(dx) / (span * 0.85)) : "";
          });
        }
        function turn(dir) {
          var span = sheet.getBoundingClientRect().width || 1;
          busy = true;
          place(dir * span, OUT);
          setTimeout(function () {
            step(dir);
            place(-dir * span, 0);   // the next one, waiting on the far side
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                place(0, IN);
                setTimeout(function () { place(0, 0); busy = false; }, IN);
              });
            });
          }, OUT);
        }

        sheet.addEventListener("pointerdown", function (ev) {
          if (busy || ev.pointerType !== "touch" || !ev.isPrimary) return;
          if (o.skip && o.skip(ev.target)) return;
          id = ev.pointerId;
          x0 = ev.clientX;
          y0 = ev.clientY;
          axis = 0;
        });
        sheet.addEventListener("pointermove", function (ev) {
          if (ev.pointerId !== id) return;
          var dx = ev.clientX - x0, dy = ev.clientY - y0;
          if (!axis) {
            if (Math.abs(dx) < MIN && Math.abs(dy) < MIN) return;
            axis = Math.abs(dx) > Math.abs(dy) * 1.4 ? 1 : -1;
          }
          if (axis !== 1) return;
          if (ev.cancelable) ev.preventDefault();
          // Past the last card there is nothing to pull in, so the card gives
          // a third of what the finger asks for and the reader feels the end.
          place(canStep(dx < 0 ? 1 : -1) ? dx : dx * 0.32, 0);
        });
        sheet.addEventListener("pointerup", function (ev) {
          if (ev.pointerId !== id) return;
          var dx = ev.clientX - x0, dir = dx < 0 ? 1 : -1;
          id = null;
          if (axis !== 1) return void (axis = 0);
          axis = 0;
          if (Math.abs(dx) >= COMMIT && canStep(dir)) {
            // Left takes you forward, as a page does.
            if (still.matches) { step(dir); return place(0, 0); }
            return turn(dir);
          }
          place(0, IN);
          setTimeout(function () { place(0, 0); }, IN);
        });
        sheet.addEventListener("pointercancel", function (ev) {
          if (ev.pointerId !== id) return;
          id = null;
          axis = 0;
          place(0, IN);
        });
      }

      holdToRepeat(
        [
          ["modal-prev", -1],
          ["modal-next", 1],
        ],
        stepEvent,
        function () { return at; },
        MODAL
      );
      swipeToStep(MODAL, stepEvent, {
        prev: "modal-prev",
        next: "modal-next",
        // The title moves with the body: they are one card, and the head above
        // them is the frame it sits in.
        cards: [document.getElementById("modal-title"), document.getElementById("modal-body")],
      });

      // Card order, not id: the cards are written in one order and rearranged
      // by CSS for the Korean view, so an index into the list they were
      // written from survives the rearranging.
      var PEOPLE = {{ people | tojson }};
      var SPEAKER_MODAL = document.getElementById("speaker-modal");
      var TALK_MODAL = document.getElementById("talk-modal");
      var spkAt = 0;

      // Who this is. Not the session sheet's speakerHtml — that renders a
      // person inside a talk, with the talk's own material under them, which
      // is the arrangement this window exists to undo.
      // "Prof. Jaeho Lee" and "이재호 교수" — the title leads in English and
      // follows in Korean, which is where each language puts it. Both are
      // always in the markup; the language switch shows one, as everywhere
      // else on the page.
      function titled(s) {
        // In the same small caps the cards set it in: a title is not the name
        // and should not be read at the name's size or weight.
        var mark = function (t) { return '<span class="role">' + esc(t) + "</span>"; };
        return (s.role ? '<span class="t-en">' + mark(s.role) + " </span>" : "") +
               s.nameHtml +
               (s.role_ko ? '<span class="t-ko"> ' + mark(s.role_ko) + "</span>" : "");
      }

      function speakerPanel(s, i) {
        var head = s.photo
          ? '<img class="sp-photo" src="' + esc(s.photo) + '" alt="" loading="lazy" />'
          : '<div class="sp-photo sp-blank" aria-hidden="true"></div>';
        var name = s.home
          ? '<a href="' + esc(s.home) + '" target="_blank" rel="noopener">' + titled(s) + "</a>"
          : titled(s);
        var bits = '<div class="sp-name">' + name;
        if (s.affil) bits += " <em>" + s.affilHtml + "</em>";
        bits += "</div>";
        // The same icons the organisers' cards carry, from the same sprite.
        var kinds = Object.keys(s.links || {});
        if (kinds.length) {
          bits += '<div class="sp-links">' + kinds.map(function (kind) {
            return '<a href="' + esc(s.links[kind]) + '" target="_blank" rel="noopener"' +
                   ' title="' + esc(kind) + '"><svg aria-hidden="true"><use href="#i-' +
                   esc(kind) + '"></use></svg></a>';
          }).join("") + "</div>";
        }
        bits += s.bio
          ? '<div class="sp-bio">' + s.bio + "</div>"
          : '<div class="sp-bio is-todo">' + tbd("Speaker bio to be added", "연사 소개 준비 중") + "</div>";
        // A door while there is something behind it, and the same shape saying
        // so while there is not — a button that opens an empty room is worse
        // than a line that says the room is empty.
        var label = '<span class="sp-talk-kicker">' + tbd("Talk", "발표") + "</span>";
        bits += s.talk
          ? '<button class="sp-talk-link" onclick="openTalk(' + i + ')">' + label +
            '<span class="sp-talk-name">' + esc(s.talk) + "</span></button>"
          : '<div class="sp-talk-link is-todo">' + label +
            '<span class="sp-talk-name">' + tbd("Title to be announced", "발표 제목 미정") + "</span></div>";
        return '<div class="sp">' + head + "<div>" + bits + "</div></div>";
      }

      function talkPanel(s, i) {
        var who = titled(s) + (s.affil ? ' <em>' + s.affilHtml + "</em>" : "");
        var bits = '<button class="tk-back" onclick="openSpeaker(' + i + ')">' +
                   '<span aria-hidden="true">&larr;</span> ' + who + "</button>";
        bits += '<h4 class="tk-title">' + esc(s.talk) + "</h4>";
        bits += s.abstract
          ? '<div class="sp-abstract">' + s.abstract + "</div>"
          : '<div class="sp-abstract is-todo">' + tbd("Abstract to be announced", "초록 준비 중") + "</div>";
        bits += s.slides
          ? '<a class="sp-slides" href="' + esc(s.slides) + '" target="_blank" rel="noopener">' +
            tbd("Slides (PDF)", "발표자료 (PDF)") + "</a>"
          : '<span class="sp-slides is-todo">' + tbd("Slides after the talk", "발표 후 자료 공개") + "</span>";
        return bits;
      }

      // The order the arrows walk. Whichever order the cards are being shown
      // in — the arrows should land on the card next to the one you came
      // from, not on the next line of an array the reader cannot see.
      function speakerOrder() {
        var idx = PEOPLE.map(function (_, i) { return i; });
        if (document.documentElement.getAttribute("data-lang") === "ko")
          idx.sort(function (a, b) { return PEOPLE[a].ko - PEOPLE[b].ko; });
        return idx;
      }

      // The rail. One tick per person in the order the cards are shown in, a
      // letter over the first tick of each surname group, and a label that
      // sits over whichever tick is being pointed at — the current one when
      // nothing is.
      var STRIP = {
        bar: document.getElementById("spk-strip-bar"),
        letters: document.getElementById("spk-letters"),
        tip: document.getElementById("spk-tip"),
        order: [],
        ticks: [],
      };

      // Only when the set or its order changes — opening the window, or the
      // language switching under it. Rebuilding these on every step was what
      // broke the drag: replacing the elements a pointer is captured on loses
      // the capture, and with it the pointerup that ends the drag.
      function drawStrip(order, cur) {
        STRIP.order = order;
        STRIP.key = order.join(",");
        var ko = document.documentElement.getAttribute("data-lang") === "ko";
        var of = function (i) { return (ko ? PEOPLE[i].letter_ko : PEOPLE[i].letter) || ""; };
        // The letter is printed once per run, not once per person: sixteen
        // letters where five of them read L is a row of Ls, not an index.
        STRIP.letters.innerHTML = order
          .map(function (i, n) {
            var here = of(i);
            return "<i>" + (n === 0 || here !== of(order[n - 1]) ? esc(here) : "") + "</i>";
          })
          .join("");
        STRIP.bar.innerHTML = order
          .map(function (i) {
            return '<button class="spk-tick' + (i === cur ? " is-current" : "") +
                   '" data-i="' + i + '" tabindex="-1"></button>';
          })
          .join("");
        STRIP.ticks = [].slice.call(STRIP.bar.children);
      }

      // Moving the mark is not redrawing the rail.
      function markStrip(cur) {
        var pos = STRIP.order.indexOf(cur);
        STRIP.ticks.forEach(function (t, n) {
          t.classList.toggle("is-current", n === pos);
        });
      }

      // Only while the pointer is on a tick. The rail says where you are by
      // marking the tick, which does not need saying again in words — the
      // panel above is already the person you are on.
      // Each tick rises with how near the pointer is and its neighbours rise
      // less — the dock's falloff. A raised cosine rather than a squared
      // linear one: squaring gives a peak with a kink at the base, and what
      // makes a dock read is that the curve leaves the line flat and comes
      // back to it flat. --k is the nearness, 0 to 1; the stylesheet decides
      // what height that buys, so the shape can be tuned without touching this.
      // Four or five ticks either side, whatever a tick is worth here. The
      // rail gives up width to the arrows beside it, so the pitch is about
      // 11px on a laptop and 6 on a small phone; a reach written in pixels
      // would be four ticks on one and ten on the other.
      function swell(x) {
        var first = STRIP.ticks[0], second = STRIP.ticks[1];
        var pitch = second
          ? second.getBoundingClientRect().left - first.getBoundingClientRect().left
          : 14;
        var reach = pitch * 4.5;
        STRIP.ticks.forEach(function (t) {
          if (x === null) return t.style.setProperty("--k", 0);
          var r = t.getBoundingClientRect();
          var d = Math.abs(x - (r.left + r.width / 2));
          var k = d >= reach ? 0 : 0.5 * (1 + Math.cos((Math.PI * d) / reach));
          t.style.setProperty("--k", k.toFixed(3));
        });
      }

      // The tick nearest a page x, so a drag can pick one out of the gaps
      // between them as well as off the marks themselves.
      function nearestTick(x) {
        var best = null, bestD = Infinity;
        STRIP.ticks.forEach(function (t, n) {
          var r = t.getBoundingClientRect();
          var d = Math.abs(x - (r.left + r.width / 2));
          if (d < bestD) { bestD = d; best = n; }
        });
        return best === null ? null : STRIP.order[best];
      }

      function point(i) {
        var s = PEOPLE[i], n = STRIP.order.indexOf(i);
        if (!s || n < 0) return;
        STRIP.tip.innerHTML = titled(s) + (s.affil ? ' <em>' + s.affilHtml + "</em>" : "");
        var bar = STRIP.bar.getBoundingClientRect();
        var tick = STRIP.ticks[n].getBoundingClientRect();
        var sheet = SPEAKER_MODAL.getBoundingClientRect();
        // Centred on the tick, and kept inside the sheet rather than inside the
        // rail: the rail is 173px on a phone and "Kwang-Sung Jun POSTECH" is
        // 185, so a label clamped to the rail would be pushed off it anyway,
        // while there is room to spare in the window it sits in.
        var half = STRIP.tip.offsetWidth / 2;
        var x = tick.left + tick.width / 2;
        var lo = sheet.left + 8 + half, hi = sheet.right - 8 - half;
        STRIP.tip.style.left = Math.max(lo, Math.min(hi, x)) - bar.left + "px";
      }

      function openSpeaker(i) {
        var s = PEOPLE[i];
        if (!s) return;
        spkAt = i;
        document.getElementById("speaker-body").innerHTML = speakerPanel(s, i);
        var order = speakerOrder(), pos = order.indexOf(i);
        document.getElementById("spk-count").textContent = pos + 1 + " / " + order.length;
        document.getElementById("spk-prev").disabled = pos === 0;
        document.getElementById("spk-next").disabled = pos === order.length - 1;
        if (STRIP.key !== order.join(",")) drawStrip(order, i);
        else markStrip(i);
        if (TALK_MODAL.open) TALK_MODAL.close();
        if (!SPEAKER_MODAL.open) SPEAKER_MODAL.showModal();
      }

      function openTalk(i) {
        var s = PEOPLE[i];
        if (!s || !s.talk) return;
        spkAt = i;
        document.getElementById("talk-body").innerHTML = talkPanel(s, i);
        if (SPEAKER_MODAL.open) SPEAKER_MODAL.close();
        if (!TALK_MODAL.open) TALK_MODAL.showModal();
      }

      function stepSpeaker(d) {
        var order = speakerOrder(), pos = order.indexOf(spkAt) + d;
        if (pos < 0 || pos >= order.length) return;
        openSpeaker(order[pos]);
      }
      // Hover to read a name, click to go there. Delegated, because the ticks
      // are rewritten on every step.
      (function () {
        var rail = document.getElementById("spk-rail");
        // On the rail, not on each tick, and by nearness rather than by what
        // is under the pointer: the gaps between the marks are two pixels
        // wide, and a label that goes out every time the cursor crosses one
        // would spend the crossing blinking.
        STRIP.bar.addEventListener("mousemove", function (ev) {
          swell(ev.clientX);
          var i = nearestTick(ev.clientX);
          if (i === null) return;
          point(i);
          rail.classList.add("is-pointing");
        });
        STRIP.bar.addEventListener("mouseleave", function () {
          if (dragging) return;
          swell(null);
          rail.classList.remove("is-pointing");
        });

        // Held and dragged, the way a scrollbar is. Pointer capture, so the
        // drag survives leaving the rail — a scrollbar you lose the moment
        // your hand strays off it is not one anybody would use.
        var dragging = false;
        var scrub = function (x) {
          swell(x);
          var i = nearestTick(x);
          if (i === null) return;
          point(i);
          rail.classList.add("is-pointing");
          if (i !== spkAt) openSpeaker(i);
        };
        STRIP.bar.addEventListener("pointerdown", function (ev) {
          dragging = true;
          rail.classList.add("is-dragging");
          try { STRIP.bar.setPointerCapture(ev.pointerId); } catch (e) {}
          scrub(ev.clientX);
          ev.preventDefault();
        });
        STRIP.bar.addEventListener("pointermove", function (ev) {
          // Nothing held means nothing is being dragged, whatever the flag
          // says. The belt to the braces below: a mouse that comes back over
          // the rail with no button down can never scrub.
          if (dragging && ev.buttons === 0) release(ev);
          if (dragging) scrub(ev.clientX);
        });
        var release = function (ev) {
          if (!dragging) return;
          dragging = false;
          rail.classList.remove("is-dragging");
          try { STRIP.bar.releasePointerCapture(ev.pointerId); } catch (e) {}
        };
        // On the window as well as the rail: a press that ends anywhere else —
        // off the rail, off the sheet, in another window — still has to end.
        ["pointerup", "pointercancel", "lostpointercapture"].forEach(function (e) {
          STRIP.bar.addEventListener(e, release);
          addEventListener(e, release);
        });
        // No click handler: pointerdown already lands on the right person, and
        // a click firing after it would only repeat the move.
      })();
      // The same hold the programme's arrows have — sixteen speakers is far
      // enough to be worth holding through rather than tapping through.
      holdToRepeat(
        [
          ["spk-prev", -1],
          ["spk-next", 1],
        ],
        stepSpeaker,
        function () { return spkAt; },
        SPEAKER_MODAL
      );
      swipeToStep(SPEAKER_MODAL, stepSpeaker, {
        prev: "spk-prev",
        next: "spk-next",
        cards: [document.getElementById("speaker-body")],
        // Not a swipe that starts on the rail: that is already a drag along
        // it, and it means something else.
        skip: function (target) {
          return !!(target.closest && target.closest(".spk-strip-bar"));
        },
      });
      SPEAKER_MODAL.addEventListener("keydown", function (ev) {
        if (ev.key === "ArrowLeft") stepSpeaker(-1);
        if (ev.key === "ArrowRight") stepSpeaker(1);
      });
      // Clicking the backdrop closes either, as on the session sheet.
      [SPEAKER_MODAL, TALK_MODAL].forEach(function (d) {
        d.addEventListener("click", function (ev) { if (ev.target === d) d.close(); });
      });

      function openEvent(id) {
        var found = EVENTS.findIndex(function (e) {
          return e.id === id;
        });
        if (found < 0) return;
        at = found;
        renderEvent();
        MODAL.showModal();
      }

      MODAL.addEventListener("keydown", function (ev) {
        if (ev.key === "ArrowLeft") stepEvent(-1);
        if (ev.key === "ArrowRight") stepEvent(1);
      });
      // Clicking the backdrop closes it.
      MODAL.addEventListener("click", function (ev) {
        if (ev.target === MODAL) MODAL.close();
      });
    </script>
  </body>
</html>
